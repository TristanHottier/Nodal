{
  "name": "nodal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test \"validation/scripts/*.test.mjs\"",
    "regen:param-specs": "NODAL_REGEN_PARAM_SPECS=1 cargo test -p nodal-engine spec_matches_ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "pnpm --filter @nodal/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chrome-launcher": "1.2.3",
    "eslint": "^10.15.0",
    "lighthouse": "13.6.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
